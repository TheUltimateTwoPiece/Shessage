# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── LiveKit ─────────────────────────────────────────────────────────────────
# Client-facing WebSocket URL from: LiveKit Cloud → Settings (or your self-hosted server)
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
# API key + secret from: LiveKit Cloud → Settings → Keys
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
